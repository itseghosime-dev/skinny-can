# ==============================================================================
# Skinny Cans Environment Variables Example
# Copy this file to .env.local for local development.
# ==============================================================================

# Freshdesk Integration (Support / Partner Ticket Generation)
# Your Freshdesk domain (e.g. 'mycompany' for 'https://mycompany.freshdesk.com')
FRESHDESK_DOMAIN=your_freshdesk_domain

# Freshdesk API Key (Found under Profile Settings > View API Key)
FRESHDESK_API_KEY=your_freshdesk_api_key

# Optional: Stadia Maps API Key for custom map styling (defaults to CartoCDN if unset)
NEXT_PUBLIC_MAPS_API_KEY=

# Base canonical URL for technical SEO and metadata generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
